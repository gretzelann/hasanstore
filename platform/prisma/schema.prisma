// Vanguard Platform — data model
//
// Dev datasource is SQLite so this runs with zero external infra.
// Swap the datasource block to `provider = "postgresql"` + a real
// connection string for production (see docs/vanguard-platform-spec.md,
// section 3) — at that point the string-typed "enum" columns below can
// become native Postgres enums if desired. They're kept as validated
// strings here because SQLite has no enum type.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------- Identity ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // "admin" | "pm" | "team_member" | "client"
  globalRole   String   @default("team_member")
  avatarUrl    String?
  // "active" | "invited" | "disabled"
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientMemberships  ClientMember[]
  channelMemberships ChannelMember[]
  channelsCreated    Channel[]       @relation("ChannelCreator")
  messagesSent       Message[]
  reactions          Reaction[]
  mentions           Mention[]
  projectsOwned      Project[]       @relation("ProjectOwner")
  cardsAssigned      Card[]          @relation("CardAssignee")
  cardsCreated       Card[]          @relation("CardCreator")
  cardComments       CardComment[]
  cardActivity       CardActivity[]  @relation("ActivityActor")
  approvalsRequested Approval[]      @relation("ApprovalRequestedBy")
  approvalsDecided   Approval[]      @relation("ApprovalDecidedBy")
  filesUploaded      File[]
  notifications      Notification[]
  auditLogs          AuditLog[]
}

// ---------- Clients ----------

model Client {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  // "onboarding" | "active" | "archived"
  status    String   @default("onboarding")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ClientMember[]
  projects Project[]
  channels Channel[]
}

model ClientMember {
  id         String   @id @default(cuid())
  clientId   String
  userId     String
  // "client_admin" | "client_collaborator"
  clientRole String   @default("client_collaborator")
  createdAt  DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
}

// ---------- Projects & boards ----------

model Project {
  id          String    @id @default(cuid())
  clientId    String
  name        String
  description String?
  // "active" | "on_hold" | "completed" | "archived"
  status      String    @default("active")
  ownerId     String
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner    User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  board    Board?
  channels Channel[]
}

model Board {
  id        String   @id @default(cuid())
  projectId String   @unique
  name      String   @default("Main board")
  createdAt DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns BoardColumn[]
  cards   Card[]
}

model BoardColumn {
  id              String  @id @default(cuid())
  boardId         String
  name            String
  position        Int
  isClientVisible Boolean @default(true)
  // "todo" | "in_progress" | "waiting_on_client" | "approved" | "done"
  mapsToStatus    String

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId])
}

model Card {
  id             String    @id @default(cuid())
  boardId        String
  columnId       String
  title          String
  description    String?
  // "low" | "medium" | "high" | "urgent"
  priority       String    @default("medium")
  dueDate        DateTime?
  assigneeId     String?
  createdById    String
  position       Int
  // "none" | "pending" | "approved" | "changes_requested"
  approvalState  String    @default("none")
  isClientFacing Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  board       Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column      BoardColumn      @relation(fields: [columnId], references: [id])
  assignee    User?            @relation("CardAssignee", fields: [assigneeId], references: [id])
  createdBy   User             @relation("CardCreator", fields: [createdById], references: [id])
  comments    CardComment[]
  attachments CardAttachment[]
  activity    CardActivity[]
  approvals   Approval[]

  @@index([boardId])
  @@index([columnId])
}

model CardComment {
  id         String   @id @default(cuid())
  cardId     String
  authorId   String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([cardId])
}

model CardAttachment {
  id        String   @id @default(cuid())
  cardId    String
  fileId    String
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id])
}

model CardActivity {
  id         String   @id @default(cuid())
  cardId     String
  actorId    String
  // "created" | "moved" | "assigned" | "commented" | "approval_requested" | "approved" | "changes_requested" | "attachment_added"
  actionType String
  fromValue  String?
  toValue    String?
  createdAt  DateTime @default(now())

  card  Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actor User @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([cardId])
}

model Approval {
  id            String    @id @default(cuid())
  cardId        String
  requestedById String
  requestedAt   DateTime  @default(now())
  decidedById   String?
  // "pending" | "approved" | "changes_requested"
  decision      String    @default("pending")
  decidedAt     DateTime?
  notes         String?

  card        Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User? @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([cardId])
}

// ---------- Chat ----------

model Channel {
  id          String   @id @default(cuid())
  // "department" | "client" | "project" | "dm" | "group"
  type        String
  name        String
  clientId    String?
  projectId   String?
  isPrivate   Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  client    Client?         @relation(fields: [clientId], references: [id])
  project   Project?        @relation(fields: [projectId], references: [id])
  createdBy User            @relation("ChannelCreator", fields: [createdById], references: [id])
  members   ChannelMember[]
  messages  Message[]
}

model ChannelMember {
  id         String    @id @default(cuid())
  channelId  String
  userId     String
  // "owner" | "member"
  role       String    @default("member")
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model Message {
  id              String    @id @default(cuid())
  channelId       String
  senderId        String
  body            String
  parentMessageId String?
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  channel     Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender      User                @relation(fields: [senderId], references: [id])
  parent      Message?            @relation("Thread", fields: [parentMessageId], references: [id])
  replies     Message[]           @relation("Thread")
  reactions   Reaction[]
  mentions    Mention[]
  attachments MessageAttachment[]

  @@index([channelId])
  @@index([parentMessageId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
}

model Mention {
  id              String   @id @default(cuid())
  messageId       String
  mentionedUserId String
  createdAt       DateTime @default(now())

  message       Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation(fields: [mentionedUserId], references: [id])

  @@index([mentionedUserId])
}

model MessageAttachment {
  id        String @id @default(cuid())
  messageId String
  fileId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id])
}

// ---------- Files ----------

model File {
  id           String   @id @default(cuid())
  uploadedById String
  filename     String
  storageKey   String
  size         Int
  mimeType     String
  // "native" | "gdrive"
  source       String   @default("native")
  createdAt    DateTime @default(now())

  uploadedBy         User                @relation(fields: [uploadedById], references: [id])
  messageAttachments MessageAttachment[]
  cardAttachments    CardAttachment[]
}

// ---------- Notifications & audit ----------

model Notification {
  id         String    @id @default(cuid())
  userId     String
  // "mention" | "approval_requested" | "approval_decided" | "card_assigned" | "comment_reply"
  type       String
  entityType String
  entityId   String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  // e.g. "login" | "role_changed" | "client_created" | "client_invited" | "approval_decided" | "file_downloaded"
  action     String
  entityType String
  entityId   String?
  metadata   String?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
}
